@@ -226,7 +226,17 @@ namespace Redflag
-	void JobSystem::Trace(bool enabled)
-	{
-		std::lock_guard<std::mutex> lock(m_Queue->Mutex);
-		m_Queue->Trace = enabled;
-		++m_Queue->TraceGeneration;
-		m_Queue->Timings.clear();
-	}
+void JobSystem::Trace(bool enabled)
+{
+    std::lock_guard<std::mutex> lock(m_Queue->Mutex);
+    if (enabled)
+    {
+        if (!m_Queue->Trace)
+        {
+            m_Queue->Trace = true;
+            ++m_Queue->TraceGeneration;
+            m_Queue->Timings.clear();
+        }
+    }
+    else
+    {
+        m_Queue->Trace = false;
+    }
+}

#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer Lighting { vec4 reflected[]; };
layout(rgba32f, binding = 1) readonly uniform image2D emitted;
layout(std430, binding = 2) writeonly buffer Output { vec4 result[]; };
layout(rgba32f, binding = 3) readonly uniform image2D albedo;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), size = imageSize(emitted);
    if (any(greaterThanEqual(p, size))) return;
    int i = p.y * size.x + p.x;
    // 自发光直接加在线性颜色上，墙角的遮蔽不会把亮着的灯牌压暗。
    vec3 light = imageLoad(albedo, p).a < 0. ? imageLoad(emitted, p).rgb : vec3(0.);
    result[i] = vec4(reflected[i].rgb + light, reflected[i].a);
}

#version 450
#include "Screen.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 2) readonly buffer Lighting { vec4 environment[]; };
layout(std430, binding = 3) writeonly buffer Result { vec4 result[]; };
#include "Environment.glsl"

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!onScreen(p)) return;
    uint i = indexOf(p);
    ScreenSurface s = surfaces[i];
    result[i] = vec4(0);
    if (s.position.w == 0.) return;

    float metallic = s.albedo.w, roughness = s.normal.w;
    float nv = clamp(dot(s.normal.xyz,viewDirection(s.position.xyz)),0.,1.);
    vec3 ks = environmentFresnel(mix(vec3(.04),s.albedo.rgb,metallic),nv,roughness);
    vec3 irradiance = cubeLight(s.normal.xyz,0,diffuseSize);
    result[i] = vec4((1.-ks)*(1.-metallic)*s.albedo.rgb*irradiance,1);
}

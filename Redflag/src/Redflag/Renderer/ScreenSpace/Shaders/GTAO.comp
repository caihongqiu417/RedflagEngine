#version 450
#include "Screen.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 2) readonly buffer Lighting
{
    vec4 colors[];
};
layout(std430, binding = 3) writeonly buffer Result
{
    vec4 result[];
};

// 沿当前截面看，horizon 是从视线转到遮挡轮廓的角度。这段圆弧上的方向能照到表面，越贴着表面入射，贡献越小。
float visibleArc(float horizon, float normalEye, float normalTangent)
{
    float s = sin(horizon);
    return .5 * normalEye * s * s + normalTangent * (.5 * horizon - .25 * sin(2. * horizon));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!onScreen(p))
        return;
    uint i = indexOf(p);
    ScreenSurface s = surfaces[i];
    if (s.position.w == 0.)
    {
        result[i] = vec4(colors[i].rgb, 1);
        return;
    }

    vec3 v = normalize(eye.xyz - s.position.xyz), n = s.normal.xyz;
    vec3 right = normalize(cross(v, vec3(view[0][1], view[1][1], view[2][1])));
    vec3 up = normalize(cross(right, v));
    float radius = material.x, visibility = 0.;
    const int directions = 4;

    for (int d = 0; d < directions; ++d)
    {
        float a = (float(d) + .5) * PI / float(directions);
        vec3 tangent = cos(a) * right + sin(a) * up;
        for (int side = -1; side <= 1; side += 2)
        {
            vec3 t = tangent * float(side);
            float nv = max(dot(n, v), 0.), nt = dot(n, t);
            float openAngle = clamp(atan(nt, max(nv, 1e-6)) + .5 * PI, 0., PI);
            float horizon = openAngle;

            for (int k = 1; k <= 8; ++k)
            {
                vec3 target = s.position.xyz + t * radius * (float(k) / 8.);
                vec4 clip = projection * view * vec4(target, 1);
                if (clip.w <= 0.)
                    break;
                ivec2 q = ivec2(floor(toPixel(clip)));
                if (!onScreen(q))
                    break;
                ScreenSurface other = surfaces[indexOf(q)];
                vec3 delta = other.position.xyz - s.position.xyz;
                float distance = length(delta);
                if (other.position.w == 0. || distance >= radius || dot(n, delta) <= .008 * radius)
                    continue;
                float angle = acos(clamp(dot(delta, v) / distance, -1., 1.));
                horizon = min(horizon, mix(angle, openAngle, smoothstep(.6 * radius, radius, distance)));
            }
            visibility += visibleArc(horizon, nv, nt);
        }
    }
    float ao = pow(clamp(visibility / float(directions), 0., 1.), material.y);
    result[i] = vec4(colors[i].rgb * ao, ao);
}

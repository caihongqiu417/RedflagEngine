#version 450
layout(local_size_x = 4, local_size_y = 4) in;
layout(set = 0, binding = 0, std430) buffer Samples { uint values[]; };
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D previous;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D current;
layout(push_constant) uniform Params { uint frame; } params;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(current);
    if (any(greaterThanEqual(p, extent))) return;
    uint i = uint(p.y * extent.x + p.x);
    values[i] += params.frame;
    imageStore(current, p, imageLoad(previous, p) + vec4(float(values[i]), p.x, p.y, 1));
}
